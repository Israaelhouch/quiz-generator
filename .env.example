# .env.example — copy to .env and fill in. `.env` is gitignored (CLAUDE.md §7).
#
# Every variable below is read somewhere in src/ or scripts/. Defaults shown
# are the ones the code actually applies when the variable is unset; a blank
# value means "unset" and gets that default.

# ---------------------------------------------------------------------------
# LLM providers — set the one matching your configured backend in
# configs/models.yaml. None of these have a default; the provider fails loudly
# if its key is missing.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
# Ollama runs locally and needs no key, only a host.
# Native default: http://localhost:11434 · docker-compose: http://host.docker.internal:11434
OLLAMA_HOST=

# Model used by the LLM-as-judge evaluation scripts.
JUDGE_MODEL=gemini-2.5-flash

# Seconds before an LLM call is abandoned. Unset = the provider's own default.
LLM_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# API security (CLAUDE.md §7 — API-key auth and rate limits by default)
# ---------------------------------------------------------------------------
# Comma-separated keys. EMPTY MEANS AUTH IS DISABLED — fine for local work,
# never for anything reachable from outside your machine.
API_KEYS=

# Requests per key per minute. Unset or 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=

# Comma-separated origins for CORS. Empty = no cross-origin browser access.
CORS_ALLOW_ORIGINS=

# ---------------------------------------------------------------------------
# Logging and observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# Append one JSON row per generation to RUNS_LOG_PATH. "1" on, "0" off.
LOG_RUNS=1

# Container paths; override when running natively (e.g. ./logs/runs.jsonl).
RUNS_LOG_PATH=/app/logs/runs.jsonl
FEEDBACK_LOG_PATH=/app/logs/feedback.jsonl

# Rotate the runs log past this size. Unset = no rotation.
RUNS_LOG_MAX_BYTES=

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# The corpus carries author_name / author_email. "0" strips them from API
# responses and logs. Leave it at 0 — CLAUDE.md §8 forbids personal data in
# logs, and this is the switch that enforces it.
INCLUDE_AUTHOR_METADATA=0
